import { createScorer } from '@mastra/core/scorers';

export const toolCallAppropriatenessScorer = createScorer({
  id: 'tool-call-appropriateness',
  description: 'Evaluates whether tool calls were appropriate for the request',
});

export const completenessScorer = createScorer({
  id: 'completeness',
  description: 'Evaluates whether the response fully addressed the user request',
});

export const translationScorer = createScorer({
  id: 'translation',
  description: 'Evaluates translation quality if applicable',
});
